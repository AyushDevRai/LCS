{
  "name": "lead-classification-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "setup": "npm run build && node dist/setup.js",
    "crm:setup": "npm run build && node --env-file-if-exists=.env dist/crmSetup.js",
    "crm:setup-sales-form": "npm run build && node --env-file-if-exists=.env dist/salesFormSetup.js",
    "test": "tsx --test tests/*.test.ts",
    "test:live-crm": "tsx --env-file-if-exists=.env scripts/testCrmSync.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": { "@fastify/cors": "^11.0.0", "@fastify/rate-limit": "^10.0.0", "dotenv": "^17.0.0", "fastify": "^5.0.0", "zod": "^4.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.0.0", "typescript": "^5.0.0" }
}
