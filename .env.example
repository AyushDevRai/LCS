HOST=127.0.0.1
PORT=4000
DATABASE_PATH=./data/lcs.sqlite
# Comma-separated exact website origins; no wildcard.
ALLOWED_ORIGINS=http://localhost:3000
# Required for scoring and webhook endpoints. Setup generates a random value.
API_TOKEN=
# Optional: leave CRM_URL empty to run locally without CRM synchronization.
CRM_URL=
CRM_API_KEY=
CRM_API_SECRET=
CRM_POLL_INTERVAL_MS=60000
CRM_RETRY_ATTEMPTS=4
# CRM fields containing explicit lead attributes, mapped to engine field names.
CRM_FIELD_MAP={"organizationType":"custom_organization_type","role":"custom_contact_role","courts":"custom_court_count","areaM2":"custom_area_m2","inServiceRegion":"custom_in_service_region","projectType":"custom_project_type","setting":"custom_setting","channel":"custom_channel","query":"custom_search_query","siteVisitRequested":"custom_site_visit_requested","rfqShared":"custom_rfq_shared","quoteRequested":"custom_quote_requested","visitorId":"custom_lcs_visitor_id"}
